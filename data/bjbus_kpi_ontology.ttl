    rdfs:label "酒测酒精检测"@zh ;
    rdfs:comment "酒测/酒精检测"@zh ;
    :domain "驾驶员管理" ;
    :primaryTable "PROD_DW.TA_CZFZSB_RYKQJL_DAY_MI" ;
    :triggerKeywords "酒测,酒精检测,酒精,醉驾,饮酒驾车" ;
    :keyMetrics """{"GH":"工号","JCJG":"检测结果","JCSJ":"检测时间","JJZL":"酒精浓度"}""" ;
    :queryTemplate """{
  "d15_today": "SELECT GH, JCJG, JCSJ, JJZL FROM PROD_DW.TA_CZFZSB_RYKQJL_DAY_MI WHERE RQ=CURDATE() ORDER BY JCSJ DESC",
  "d15_abnormal": "SELECT GH, JJZL, JCSJ FROM PROD_DW.TA_CZFZSB_RYKQJL_DAY_MI WHERE RQ=CURDATE() AND JCJG='不合格' ORDER BY JJZL DESC"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[D-15→d15_abnormal]: 酒精超标（≥20mg/100ml）驾驶员禁止出车" .

:D-16 a :Report ;
    rdfs:label "驾驶员画像季度评价"@zh ;
    rdfs:comment "驾驶员画像/季度评价/模范驾驶员"@zh ;
    :domain "驾驶员管理" ;
    :primaryTable "PROD_DW.TA_AQJH_PJQK_QUARTER_DI" ;
    :triggerKeywords "驾驶员画像,季度评价,模范驾驶员,驾驶员评分,驾驶员绩效" ;
    :keyMetrics """{"GH":"工号","PJDF":"评价得分","PJJD":"评价季度","MFJSY":"是否模范"}""" ;
    :queryTemplate """{
  "d16_current_quarter": "SELECT GH, PJDF, PJJD, MFJSY FROM PROD_DW.TA_AQJH_PJQK_QUARTER_DI WHERE RQ>=DATE_SUB(CURDATE(), INTERVAL 90 DAY) ORDER BY PJDF DESC",
  "d16_top_drivers": "SELECT GH, PJDF FROM PROD_DW.TA_AQJH_PJQK_QUARTER_DI WHERE RQ>=DATE_SUB(CURDATE(), INTERVAL 90 DAY) ORDER BY PJDF DESC LIMIT {rank_n}"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[D-16→d16_current_quarter]: 季度评价覆盖安全/服务/效率三维度" .

:D-17 a :Entity ;
    rdfs:label "驾驶员信息驾龄"@zh ;
    rdfs:comment "驾驶员信息/驾龄"@zh ;
    :domain "驾驶员管理" ;
    :primaryTable "PROD_DW.TA_AS_BJ_DRIVER_INFO_DA" ;
    :triggerKeywords "驾驶员信息,驾龄,司机档案,驾驶员档案,从业年限" ;
    :keyMetrics """{"GH":"工号","XM":"姓名","JL":"驾龄","GZRQ":"工作日期","FGS":"分公司"}""" ;
    :queryTemplate """{
  "d17_by_gh": "SELECT GH, XM, JL, GZRQ, FGS FROM PROD_DW.TA_AS_BJ_DRIVER_INFO_DA WHERE GH='{gh}'",
  "d17_by_org": "SELECT GH, XM, JL FROM PROD_DW.TA_AS_BJ_DRIVER_INFO_DA WHERE FGS='{org}' ORDER BY JL DESC"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[D-17→d17_by_gh]: 驾驶员信息为基础档案，驾龄关联风险评估" .

:D-18 a :Entity ;
    rdfs:label "体检记录"@zh ;
    rdfs:comment "体检记录/体检日期"@zh ;
    :domain "驾驶员管理" ;
    :primaryTable "PROD_DW.TF_PS_RL_TJRYXX_DA" ;
    :triggerKeywords "体检记录,体检,体检日期,健康检查,年度体检" ;
    :keyMetrics """{"GH":"工号","TJRQ":"体检日期","TJJG":"体检结果","XYRQ":"下次预约"}""" ;
    :queryTemplate """{
  "d18_by_gh": "SELECT GH, TJRQ, TJJG, XYRQ FROM PROD_DW.TF_PS_RL_TJRYXX_DA WHERE GH='{gh}' ORDER BY TJRQ DESC",
  "d18_overdue": "SELECT GH, TJRQ FROM PROD_DW.TF_PS_RL_TJRYXX_DA WHERE TJRQ<DATE_SUB(CURDATE(), INTERVAL 365 DAY) ORDER BY TJRQ ASC"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[D-18→d18_overdue]: 超365天未体检驾驶员需预警" .

# =============================================================================
# Domain SC：稽查客诉
# =============================================================================

:SC-01 a :Event ;
    rdfs:label "综合稽查"@zh ;
    rdfs:comment "稽查/综合稽查"@zh ;
    :domain "稽查客诉" ;
    :primaryTable "PROD_DW.TF_PS_ZHJC_JCWTGDCLJL_DA" ;
    :triggerKeywords "稽查,综合稽查,检查,稽查记录,违规稽查,安全检查" ;
    :keyMetrics """{"JCLX":"稽查类型","WTMS":"问题描述","CLJG":"处理结果","JCSJ":"稽查时间"}""" ;
    :queryTemplate """{
  "sc01_recent": "SELECT JCLX, WTMS, CLJG, JCSJ FROM PROD_DW.TF_PS_ZHJC_JCWTGDCLJL_DA WHERE RQ>=DATE_SUB(CURDATE(), INTERVAL 30 DAY) ORDER BY JCSJ DESC",
  "sc01_by_type": "SELECT JCLX, COUNT(*) AS CNT FROM PROD_DW.TF_PS_ZHJC_JCWTGDCLJL_DA WHERE RQ>=DATE_SUB(CURDATE(), INTERVAL 30 DAY) GROUP BY JCLX ORDER BY CNT DESC"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[SC-01→sc01_recent]: 综合稽查问题需及时处理和反馈" .

:SC-02 a :Event ;
    rdfs:label "客诉市民意见投诉"@zh ;
    rdfs:comment "客诉/市民意见/投诉"@zh ;
    :domain "稽查客诉" ;
    :primaryTable "PROD_DW.TA_PS_SMYJ_GDMX_DA" ;
    :triggerKeywords "客诉,投诉,市民意见,乘客投诉,服务投诉,客户意见" ;
    :keyMetrics """{"TSLX":"投诉类型","TSMS":"投诉描述","CLJG":"处理结果","TSSJ":"投诉时间"}""" ;
    :queryTemplate """{
  "sc02_recent": "SELECT TSLX, TSMS, CLJG, TSSJ FROM PROD_DW.TA_PS_SMYJ_GDMX_DA WHERE RQ>=DATE_SUB(CURDATE(), INTERVAL 30 DAY) ORDER BY TSSJ DESC",
  "sc02_by_type": "SELECT TSLX, COUNT(*) AS CNT FROM PROD_DW.TA_PS_SMYJ_GDMX_DA WHERE RQ>=DATE_SUB(CURDATE(), INTERVAL 30 DAY) GROUP BY TSLX ORDER BY CNT DESC",
  "sc02_today": "SELECT TSLX, TSMS, TSSJ FROM PROD_DW.TA_PS_SMYJ_GDMX_DA WHERE RQ=CURDATE() ORDER BY TSSJ DESC"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[SC-02→sc02_recent]: 客诉须在规定时限内回复处理" .

# =============================================================================
# Domain P：乘客客流
# =============================================================================

:P-01 a :Report ;
    rdfs:label "时段客流趟次客流"@zh ;
    rdfs:comment "时段客流/趟次客流"@zh ;
    :domain "乘客客流" ;
    :primaryTable "PROD_DW.TA_YYDD_DD_KLFX_TC_DAY_MI" ;
    :triggerKeywords "时段客流,趟次客流,每趟客流,分时客流,班次客流" ;
    :keyMetrics """{"TCSJ":"趟次时间","SCKYL":"上车客运量","XCKYL":"下车客运量","SD":"时段"}""" ;
    :queryTemplate """{
  "p01_daily": "SELECT SD, SUM(SCKYL) AS SCKYL FROM PROD_DW.TA_YYDD_DD_KLFX_TC_DAY_MI WHERE RQ=CURDATE() GROUP BY SD ORDER BY SD",
  "p01_by_line": "SELECT TCSJ, SCKYL, XCKYL FROM PROD_DW.TA_YYDD_DD_KLFX_TC_DAY_MI WHERE RQ='{date}' AND XLH='{line}' ORDER BY TCSJ",
  "p01_peak": "SELECT SD, SUM(SCKYL) AS SCKYL FROM PROD_DW.TA_YYDD_DD_KLFX_TC_DAY_MI WHERE RQ=CURDATE() GROUP BY SD ORDER BY SCKYL DESC LIMIT {rank_n}"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[P-01→p01_daily]: 按时段汇总客流用于高峰分析" .

:P-02 a :Report ;
    rdfs:label "老年客流老年乘客"@zh ;
    rdfs:comment "老年客流/老年乘客"@zh ;
    :domain "乘客客流" ;
    :primaryTable "PROD_STAT.TA_YYDD_ONBOARD_BUS_MI" ;
    :triggerKeywords "老年客流,老年乘客,老人,老年人,敬老卡,老年优惠" ;
    :keyMetrics """{"LNKYL":"老年客运量","LNBL":"老年占比","XLH":"线路"}""" ;
    :queryTemplate """{
  "p02_daily": "SELECT XLH, SUM(LNKYL) AS LNKYL, AVG(LNBL) AS LNBL FROM PROD_STAT.TA_YYDD_ONBOARD_BUS_MI WHERE RQ=CURDATE() GROUP BY XLH",
  "p02_ranking": "SELECT XLH, SUM(LNKYL) AS LNKYL FROM PROD_STAT.TA_YYDD_ONBOARD_BUS_MI WHERE RQ=CURDATE() GROUP BY XLH ORDER BY LNKYL DESC LIMIT {rank_n}"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[P-02→p02_daily]: 老年客流占比高线路需关注无障碍服务" .

:P-03 a :Report ;
    rdfs:label "当前老年乘客"@zh ;
    rdfs:comment "当前老年乘客"@zh ;
    :domain "乘客客流" ;
    :primaryTable "PROD_STAT.TA_YYDD_ONBOARD_BUS_LATEST_MI" ;
    :triggerKeywords "当前老年乘客,实时老年,在车老年人,当前老年" ;
    :keyMetrics """{"CLZBH":"车辆","LNCS":"老年人数","SCSJ":"上传时间"}""" ;
    :queryTemplate """{
  "p03_realtime": "SELECT CLZBH, LNCS, SCSJ FROM PROD_STAT.TA_YYDD_ONBOARD_BUS_LATEST_MI ORDER BY SCSJ DESC LIMIT 50",
  "p03_by_vehicle": "SELECT CLZBH, LNCS, SCSJ FROM PROD_STAT.TA_YYDD_ONBOARD_BUS_LATEST_MI WHERE CLZBH='{zbh}' ORDER BY SCSJ DESC LIMIT 1"
}""" ;
    :partitionField "RQ" ;
    :businessRule "[P-03→p03_realtime]: 实时老年乘客数用于安全辅助决策" .
